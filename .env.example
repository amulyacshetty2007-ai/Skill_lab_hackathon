# Copy to .env and change the values for anything beyond a local demo.
POSTGRES_PASSWORD=change-this-database-password
# at least 32 random characters, e.g.  openssl rand -hex 48
JWT_SECRET=change-this-to-a-long-random-string-0123456789abcdef
# people need this code to register as an organiser
ORGANISER_INVITE_CODE=choose-a-secret-invite-code
ALLOWED_ORIGINS=http://localhost:8080
# true when served over https
COOKIE_SECURE=false
# set false to start with an empty database (no demo trains or accounts)
SEED_DEMO_DATA=true
